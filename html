    <script>
        function scrollFileira(botao, direcao) {
            const carrosselContainer = botao.parentElement;
            const carrossel = carrosselContainer.querySelector('.cards-carrossel');
            const larguraCard = carrossel.querySelector('.card').offsetWidth + 25;
            carrossel.scrollBy({
                left: direcao * larguraCard,
                behavior: 'smooth'
            });
        }

        /* ===== BUSCA NO CARDÁPIO ===== */
        const buscaInput = document.getElementById('busca-input');
        const listaSugestoes = document.getElementById('busca-sugestoes');
        const avisoBusca = document.getElementById('busca-aviso');
        const todosCards = Array.from(document.querySelectorAll('#cardapio .card'));

        // Ignora acentos e maiúsculas (ex: "pao" encontra "Pão")
        const normalizar = (t) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();

        function buscar(termo) {
            const q = normalizar(termo);
            if (!q) return [];
            return todosCards.filter(card =>
                normalizar(card.querySelector('h3').textContent).includes(q) ||
                normalizar(card.querySelector('p').textContent).includes(q)
            );
        }

        function irParaCard(card) {
            const carrossel = card.closest('.cards-carrossel');
            carrossel.scrollTo({ left: card.offsetLeft - carrossel.offsetLeft - 5, behavior: 'smooth' });
            card.scrollIntoView({ behavior: 'smooth', block: 'center' });

            todosCards.forEach(c => c.classList.remove('card-encontrado'));
            card.classList.add('card-encontrado');
            setTimeout(() => card.classList.remove('card-encontrado'), 3000);

            listaSugestoes.hidden = true;
            avisoBusca.hidden = true;
            buscaInput.value = card.querySelector('h3').textContent;
        }

        buscaInput.addEventListener('input', () => {
            const resultados = buscar(buscaInput.value);
            listaSugestoes.innerHTML = '';
            avisoBusca.hidden = !(buscaInput.value.trim() && resultados.length === 0);
            listaSugestoes.hidden = resultados.length === 0;

            resultados.slice(0, 6).forEach(card => {
                const categoria = card.closest('.categoria-bloco').querySelector('.titulo-categoria').textContent;
                const li = document.createElement('li');
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.innerHTML = '<span></span><small></small>';
                btn.children[0].textContent = card.querySelector('h3').textContent;
                btn.children[1].textContent = categoria;
                btn.addEventListener('click', () => irParaCard(card));
                li.appendChild(btn);
                listaSugestoes.appendChild(li);
            });
        });

        buscaInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                const resultados = buscar(buscaInput.value);
                if (resultados.length) irParaCard(resultados[0]);
            }
            if (e.key === 'Escape') listaSugestoes.hidden = true;
        });

        document.addEventListener('click', (e) => {
            if (!e.target.closest('.busca')) listaSugestoes.hidden = true;
        });
    </script>

